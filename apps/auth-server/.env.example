# auth.sandbox.com 相当。ローカルは auth.localhost
PORT=3000
ISSUER=http://auth.localhost:3000

# HTTPS のときのみ true。true にすると Secure 属性と __Host- プレフィックスを付ける
COOKIE_SECURE=false

# Identity DB。sandbox_auth ロール
DATABASE_URL=postgres://sandbox_auth:sandbox_auth@127.0.0.1:5432/sandbox

# Cognito Token 保存時の暗号化鍵。base64 の 32 バイト。ローカル用の固定値
TOKEN_ENCRYPTION_KEY_ID=local-1
TOKEN_ENCRYPTION_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=

# 署名鍵の PKCS#8 PEM。未設定なら起動ごとに生成する
# SIGNING_KEY_PEM=

# Cognito アダプタ。mock のみ実装済み
COGNITO_ADAPTER=mock
# モックユーザー。cognito_sub は db/init/004_seed.sql と一致させる。alice: tanaka owner / suzuki viewer, bob: suzuki admin, carol: 所属なし
MOCK_COGNITO_USERS=[{"username":"alice","password":"alice-password","sub":"cognito-sub-alice","email":"alice@example.com","name":"Alice"},{"username":"bob","password":"bob-password","sub":"cognito-sub-bob","email":"bob@example.com","name":"Bob"},{"username":"carol","password":"carol-password","sub":"cognito-sub-carol","email":"carol@example.com","name":"Carol"}]

# Session / Code Store。未設定ならインメモリ。ローカルは docker compose の redis を使える
# REDIS_URL=redis://127.0.0.1:6379

# COGNITO_ADAPTER=sdk のときに必要。Terraform の出力から設定する
# COGNITO_REGION=ap-northeast-1
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=
