# api.crm.sandbox.com 相当
PORT=3002

# この API の公開 URL。そのまま aud になり、oidc_clients.audience と一致させる。Host が違うリクエストは 404
API_BASE_URL=http://api.crm.localhost:3002

# auth.sandbox.com 相当。iss 検証に使う
ISSUER=http://auth.localhost:3000
# JWKS 取得と管理 API 用。DNS に依存しない
AUTH_BACKCHANNEL_URL=http://127.0.0.1:3000

# auth-api の管理 API を呼ぶ Client 認証。crm-web と同じ値
CLIENT_ID=crm
CLIENT_SECRET=crm-v3R_5OBDCC6k8EeDKB6l5YltYVTSeJQZxpU-2-PE7VU

# CRM 自身の DB。crm_app ロール。identity DB には接続しない
DATABASE_URL=postgres://crm_app:crm_app@127.0.0.1:5433/crm
