# <tenant>.cms.sandbox.com 相当
PORT=3003
# https にすると Cookie に Secure と __Host- が付き、REDIS_URL と https の ISSUER / API_BASE_URL が必須になる
PUBLIC_SCHEME=http

# auth.sandbox.com 相当。discovery と /authorize へのリダイレクトに使う
ISSUER=http://auth.localhost:3000
# Token / JWKS 取得用。DNS に依存しない
AUTH_BACKCHANNEL_URL=http://127.0.0.1:3000

# 未設定ならインメモリ。複数プロセスで動かすときは Redis を指す
# REDIS_URL=redis://127.0.0.1:6379

# このプロセスが担当するサービス。oidc_clients の登録値と一致させる
CLIENT_ID=cms
# 32 バイト以上の乱数。db/init/004_seed.sql のハッシュと対応するローカル固定値
CLIENT_SECRET=cms-D-t4BfncXGWLx6FnGD0DW1gJroNFYm1GDm8QSgOYNLA
SERVICE_NAME=CMS
# テナントのサブドメインを除いたホスト。Host <tenant>.<BASE_HOST> からテナントを解決する
BASE_HOST=cms.localhost:3003
# cms-api の公開 URL。aud と一致させる
API_BASE_URL=http://api.cms.localhost:3004
