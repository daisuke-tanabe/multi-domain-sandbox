{
  "name": "@sandbox/crm-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n bff,spa \"node --env-file-if-exists=.env --import tsx --watch src/main.ts\" \"react-router dev\"",
    "build": "react-router build",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "typegen": "react-router typegen",
    "typecheck": "react-router typegen && tsc -p tsconfig.json && tsc -p tsconfig.app.json"
  },
  "dependencies": {
    "@sandbox/api-contract": "workspace:*",
    "@sandbox/web-core": "workspace:*",
    "@sandbox/web-ui": "workspace:*",
    "isbot": "^5",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "tsx": "catalog:"
  },
  "devDependencies": {
    "@react-router/dev": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "concurrently": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
