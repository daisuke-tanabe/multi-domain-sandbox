# api.sandbox.com 相当
PORT=3002

# Access Token の aud。auth-server の API_AUDIENCE と一致させる
API_AUDIENCE=http://api.localhost:3002

# auth.sandbox.com 相当。iss 検証に使う
ISSUER=http://auth.localhost:3000
# JWKS 取得用。DNS に依存しない
AUTH_BACKCHANNEL_URL=http://127.0.0.1:3000

# sandbox_api ロール。identity スキーマは SELECT のみ、business スキーマは RLS 適用
DATABASE_URL=postgres://sandbox_api:sandbox_api@127.0.0.1:5432/sandbox
