# api.cms.sandbox.com 相当
PORT=3004

# この API の公開 URL。そのまま aud になり、oidc_clients.audience と一致させる。Host が違うリクエストは 404
API_BASE_URL=http://api.cms.localhost:3004

# auth.sandbox.com 相当。iss 検証に使う
ISSUER=http://auth.localhost:3000
# JWKS 取得と管理 API 用。DNS に依存しない
AUTH_BACKCHANNEL_URL=http://127.0.0.1:3000

# auth-api の管理 API を呼ぶ Client 認証。cms-web と同じ値
CLIENT_ID=cms
CLIENT_SECRET=cms-D-t4BfncXGWLx6FnGD0DW1gJroNFYm1GDm8QSgOYNLA

# CMS 自身の DB。cms_app ロール。identity DB には接続しない
DATABASE_URL=postgres://cms_app:cms_app@127.0.0.1:5434/cms
