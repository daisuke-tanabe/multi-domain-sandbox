    "cognito-srp-helper": "catalog:",
    "hono": "catalog:",
    "pg": "catalog:",
    "tsx": "catalog:",
    "ulid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
