# auth.sandbox.com 相当。ローカルは auth.localhost
# https にすると Cookie に Secure と __Host- が付き、SIGNING_KEY_PEM / REDIS_URL / COGNITO_ADAPTER=sdk が必須になる
PORT=3000
ISSUER=http://auth.localhost:3000

# identity DB。sandbox_auth ロール。auth-api だけが接続する
DATABASE_URL=postgres://sandbox_auth:sandbox_auth@127.0.0.1:5432/identity

# Cognito Token 保存時の暗号化鍵。base64 の 32 バイト。ローカル用の固定値
TOKEN_ENCRYPTION_KEY_ID=local-1
TOKEN_ENCRYPTION_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=

# 署名鍵の PKCS#8 PEM。未設定なら起動ごとに生成する
# SIGNING_KEY_PEM=

# Cognito アダプタ。mock のみ実装済み
COGNITO_ADAPTER=mock
# モックユーザー。cognito_sub は db/identity/init/003_seed.sql と一致させる。alice / bob はシード済み、carol は割り当てなし、dave は identity に無く招待の確認用
# totpSecret は登録済みの認証アプリの secret。dave には無く、初回ログインで登録する。テストと確認スクリプトは同じ値でコードを作る
MOCK_COGNITO_USERS=[{"username":"alice","password":"alice-password","sub":"cognito-sub-alice","email":"alice@example.com","name":"Alice","totpSecret":"JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP"},{"username":"bob","password":"bob-password","sub":"cognito-sub-bob","email":"bob@example.com","name":"Bob","totpSecret":"GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ"},{"username":"carol","password":"carol-password","sub":"cognito-sub-carol","email":"carol@example.com","name":"Carol","totpSecret":"MFRGGZDFMZTWQ2LKNNWG23TPOBYXE43V"},{"username":"dave","password":"dave-password","sub":"cognito-sub-dave","email":"dave@example.com","name":"Dave"}]

# Session / Code Store。未設定ならインメモリ。ローカルは docker compose の redis を使える
# REDIS_URL=redis://127.0.0.1:6379

# COGNITO_ADAPTER=sdk のときに必要。Terraform の出力から設定する
# COGNITO_REGION=ap-northeast-1
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=

# apps/auth-web の配り方。開発時は react-router dev の Vite サーバーへ中継し、本番は react-router build の成果物を配る
# SPA_DIR を設定すると SPA_DEV_SERVER_URL より優先される
SPA_DEV_SERVER_URL=http://127.0.0.1:5175
# SPA_DIR=../auth-web/build/client
