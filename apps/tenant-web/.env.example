# tenant-*.sandbox.com 相当。1 プロセスで複数テナントのホストを受ける
PORT=3001
PUBLIC_SCHEME=http
# Host ヘッダは <slug>.<PUBLIC_BASE_HOST> の形式で来る
PUBLIC_BASE_HOST=localhost:3001

# auth.sandbox.com 相当
ISSUER=http://auth.localhost:3000
# サーバー間通信用。DNS に依存しない
AUTH_BACKCHANNEL_URL=http://127.0.0.1:3000

# api.sandbox.com 相当。サーバー間通信用
API_BACKCHANNEL_URL=http://127.0.0.1:3002

# HTTPS のときのみ true
COOKIE_SECURE=false

# テナントごとの Client 資格情報。本番は Secret Store から slug をキーに取得する
TENANT_CLIENTS=[{"slug":"tenant-a","clientSecret":"tenant-a-secret"},{"slug":"tenant-b","clientSecret":"tenant-b-secret"}]
