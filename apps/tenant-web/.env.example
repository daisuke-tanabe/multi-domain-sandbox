# <tenant>.<service>.sandbox.com 相当。1 プロセスで複数サービス × 複数テナントのホストを受ける
PORT=3001
PUBLIC_SCHEME=http

# auth.sandbox.com 相当
ISSUER=http://auth.localhost:3000
# サーバー間通信用。DNS に依存しない
AUTH_BACKCHANNEL_URL=http://127.0.0.1:3000

# HTTPS のときのみ true
COOKIE_SECURE=false

# サービスごとの Client 資格情報。本番は Secret Store から取得する
# baseHost の前にテナント slug が付く。例 tanaka.crm.localhost:3001
SERVICES=[{"clientId":"crm","clientSecret":"crm-secret","name":"CRM","baseHost":"crm.localhost:3001","apiBaseUrl":"http://api.crm.localhost:3002"},{"clientId":"cms","clientSecret":"cms-secret","name":"CMS","baseHost":"cms.localhost:3001","apiBaseUrl":"http://api.cms.localhost:3002"}]

# Session Store。未設定ならインメモリ
# REDIS_URL=redis://127.0.0.1:6379
