# RDS のマスター接続。Terraform の出力と Secrets Manager から設定する
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/sandbox

# アプリ用ロールのパスワード。RDS では固定値を使わず Secrets Manager の値を渡す
AUTH_DB_PASSWORD=sandbox_auth
API_DB_PASSWORD=sandbox_api

# redirect_uri と backchannel_logout_uri の生成に使う
PUBLIC_SCHEME=https

# サービス (OIDC Client) ごとの設定。clientSecret は各 *-web の CLIENT_SECRET と同じ値で、32 バイト以上の乱数
SERVICES=[{"clientId":"crm","clientSecret":"<43 文字以上の乱数>","name":"CRM","baseHost":"crm.sandbox.example.com","apiBaseUrl":"https://api.crm.sandbox.example.com"},{"clientId":"cms","clientSecret":"<43 文字以上の乱数>","name":"CMS","baseHost":"cms.sandbox.example.com","apiBaseUrl":"https://api.cms.sandbox.example.com"}]

# Cognito にテストユーザーを作る場合に設定する。未設定ならローカルと同じ固定 cognito_sub でシードする
# COGNITO_REGION=ap-northeast-1
# COGNITO_USER_POOL_ID=
# テストユーザーのパスワード。Cognito のパスワードポリシーを満たす値
# SEED_USER_PASSWORD=
